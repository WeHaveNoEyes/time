# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Right-click server > Copy Server ID (enable Developer Mode in Discord settings)
GUILD_ID=

# Right-click voice channel > Copy Channel ID
VOICE_CHANNEL_ID=

# ElevenLabs API key from https://elevenlabs.io
ELEVENLABS_API_KEY=

# How often to announce the time, in minutes (default: 15, min: 1)
# Set to 1 for testing
ANNOUNCE_INTERVAL_MINUTES=15
